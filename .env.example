# Copia este archivo como .env y ajusta los valores si fuera necesario.
# El instalador genera un socket privado en /tmp y completa el usuario local.
PGHOST=/tmp/chinook_pg_TU_USUARIO
PGPORT=55432
PGUSER=TU_USUARIO
PGDATABASE=chinook_dw
PREFECT_SERVER_ANALYTICS_ENABLED=false

# Solo es necesaria si eliges una conexión TCP con contraseña.
# PGPASSWORD=cambia_este_valor
