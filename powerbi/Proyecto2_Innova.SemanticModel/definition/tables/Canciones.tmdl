/// Tabla de negocio importada directamente desde chinook_dw.public.dim_track; modelo estrella del Proyecto 1.
table Canciones
	lineageTag: 5dc682d0-20e2-4773-9a16-a8fcbc78c225

	/// KPI-06 | Responsable: Brian Rodriguez. Participación del género de mayores ingresos entre los géneros del contexto seleccionado. Menor concentración favorece diversificación, no equivale por sí sola a mayor rentabilidad.
	measure 'Concentración de ingresos por género musical' =
			VAR _Generos = ADDCOLUMNS(
			    VALUES('Canciones'[Género]),
			    "__IngresosGenero", CALCULATE([Ingresos])
			)
			VAR _Lider = MAXX(_Generos, [__IngresosGenero])
			RETURN IF(HASONEVALUE('Fecha'[Periodo]), DIVIDE(_Lider, [Ingresos]))
		formatString: 0.0%
		displayFolder: KPIs aprobados
		lineageTag: 819274e1-2a61-453f-b77d-0436a9ad54f5

	/// Valor del KPI-06 en el mes anterior para comparación, no una meta aprobada.
	measure 'KPI-06 mes anterior' =
			VAR _FechasAnteriores = PREVIOUSMONTH('Fecha'[Fecha])
			RETURN
			    IF(
			        HASONEVALUE('Fecha'[Periodo]),
			        CALCULATE([Concentración de ingresos por género musical], REMOVEFILTERS('Fecha'), _FechasAnteriores)
			    )
		formatString: 0.0%
		displayFolder: Comparación mensual
		lineageTag: 7252d736-0dbc-4532-a36d-db80541e2460

	/// Diferencia frente al mes anterior. En tasas representa diferencia de proporciones, no crecimiento relativo.
	measure 'KPI-06 cambio' =
			VAR _Actual = [Concentración de ingresos por género musical]
			VAR _Anterior = [KPI-06 mes anterior]
			RETURN IF(NOT ISBLANK(_Actual) && NOT ISBLANK(_Anterior), _Actual - _Anterior)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Comparación mensual
		lineageTag: cb9541cc-84dc-4e3d-ad96-58d7ced6c7d0

	/// Color condicional según el cambio histórico. No representa cumplimiento de una meta que no fue fijada.
	measure 'KPI-06 color' =
			VAR _Cambio = [KPI-06 cambio]
			RETURN SWITCH(
			    TRUE(),
			    ISBLANK(_Cambio), "#68798B",
			    _Cambio = 0, "#68798B",
			    _Cambio < 0, "#00897B",
			    "#CB4B4B"
			)
		formatString: @
		isHidden
		displayFolder: Formato condicional
		lineageTag: 9f24744c-e6f8-4284-b03b-788bc9038d9b

	/// KPI-08 | Responsable: Miguel Cruz. Ingresos de exactamente los cinco artistas líderes / ingresos del contexto. Se desempata por Id artista para evitar que TOPN incluya más de cinco artistas empatados.
	measure 'Concentración de ingresos en los cinco artistas principales' =
			VAR _Artistas = ADDCOLUMNS(
			    VALUES('Canciones'[Id artista]),
			    "__IngresosArtista", CALCULATE([Ingresos])
			)
			VAR _ConVenta = FILTER(_Artistas, NOT ISBLANK([__IngresosArtista]) && [__IngresosArtista] > 0)
			VAR _Cinco = TOPN(
			    5, _ConVenta,
			    [__IngresosArtista], DESC,
			    'Canciones'[Id artista], ASC
			)
			VAR _IngresosTop = SUMX(_Cinco, [__IngresosArtista])
			RETURN IF(HASONEVALUE('Fecha'[Periodo]), DIVIDE(_IngresosTop, [Ingresos]))
		formatString: 0.0%
		displayFolder: KPIs aprobados
		lineageTag: 9672465c-3eaa-43e5-97ae-ae43578efa8f

	/// Valor del KPI-08 en el mes anterior para comparación, no una meta aprobada.
	measure 'KPI-08 mes anterior' =
			VAR _FechasAnteriores = PREVIOUSMONTH('Fecha'[Fecha])
			RETURN
			    IF(
			        HASONEVALUE('Fecha'[Periodo]),
			        CALCULATE([Concentración de ingresos en los cinco artistas principales], REMOVEFILTERS('Fecha'), _FechasAnteriores)
			    )
		formatString: 0.0%
		displayFolder: Comparación mensual
		lineageTag: 6d4285d5-91fb-40f4-ac70-6f89faeb2ea0

	/// Diferencia frente al mes anterior. En tasas representa diferencia de proporciones, no crecimiento relativo.
	measure 'KPI-08 cambio' =
			VAR _Actual = [Concentración de ingresos en los cinco artistas principales]
			VAR _Anterior = [KPI-08 mes anterior]
			RETURN IF(NOT ISBLANK(_Actual) && NOT ISBLANK(_Anterior), _Actual - _Anterior)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Comparación mensual
		lineageTag: 7d915e83-60a6-4d14-901a-a05455410864

	/// Color condicional según el cambio histórico. No representa cumplimiento de una meta que no fue fijada.
	measure 'KPI-08 color' =
			VAR _Cambio = [KPI-08 cambio]
			RETURN SWITCH(
			    TRUE(),
			    ISBLANK(_Cambio), "#68798B",
			    _Cambio = 0, "#68798B",
			    _Cambio < 0, "#00897B",
			    "#CB4B4B"
			)
		formatString: @
		isHidden
		displayFolder: Formato condicional
		lineageTag: f115432f-ff15-403b-b7cc-46f96e6b8c3d

