	partition Canciones = m
		mode: import
		source =
				let
				    Origen = PostgreSQL.Database(Servidor, BaseDatos, [CreateNavigationProperties=false]),
				    Tabla = Origen{[Schema="public", Item="dim_track"]}[Data],
				    Seleccion = Table.SelectColumns(Tabla, {"track_key", "track_id", "track_name", "genre_name", "artist_id", "artist_name", "album_title", "media_type_name", "duration_minutes"}),
				    Nombres = Table.RenameColumns(Seleccion, {{"track_key", "Clave canción"}, {"track_id", "Id canción"}, {"track_name", "Contenido"}, {"genre_name", "Género"}, {"artist_id", "Id artista"}, {"artist_name", "Artista"}, {"album_title", "Álbum"}, {"media_type_name", "Tipo de medio"}, {"duration_minutes", "Duración minutos"}}),
				    Tipos = Table.TransformColumnTypes(Nombres, {{"Clave canción", Int64.Type}, {"Id canción", Int64.Type}, {"Contenido", type text}, {"Género", type text}, {"Id artista", Int64.Type}, {"Artista", type text}, {"Álbum", type text}, {"Tipo de medio", type text}, {"Duración minutos", Currency.Type}})
				in
				    Tipos

