	partition Ventas = m
		mode: import
		source =
				let
				    Origen = PostgreSQL.Database(Servidor, BaseDatos, [CreateNavigationProperties=false]),
				    Tabla = Origen{[Schema="public", Item="fact_sales"]}[Data],
				    Seleccion = Table.SelectColumns(Tabla, {"sales_key", "date_key", "customer_key", "track_key", "employee_key", "invoice_id", "invoice_line_id", "quantity", "unit_price", "total_amount"}),
				    Nombres = Table.RenameColumns(Seleccion, {{"sales_key", "Clave venta"}, {"date_key", "Clave fecha"}, {"customer_key", "Clave cliente"}, {"track_key", "Clave canción"}, {"employee_key", "Clave empleado"}, {"invoice_id", "Id factura"}, {"invoice_line_id", "Id línea"}, {"quantity", "Unidades"}, {"unit_price", "Precio unitario"}, {"total_amount", "Importe"}}),
				    Tipos = Table.TransformColumnTypes(Nombres, {{"Clave venta", Int64.Type}, {"Clave fecha", Int64.Type}, {"Clave cliente", Int64.Type}, {"Clave canción", Int64.Type}, {"Clave empleado", Int64.Type}, {"Id factura", Int64.Type}, {"Id línea", Int64.Type}, {"Unidades", Int64.Type}, {"Precio unitario", Currency.Type}, {"Importe", Currency.Type}})
				in
				    Tipos

