/// Tabla de negocio importada directamente desde chinook_dw.public.fact_sales; modelo estrella del Proyecto 1.
table Ventas
	lineageTag: 5b4b569b-8c1a-499c-a38a-f16c0a385dae

	/// Ingresos por ventas del DW. La fuente no identifica moneda ni costos; no representa utilidad.
	measure Ingresos = SUM('Ventas'[Importe])
		formatString: #,##0.00 "UM"
		displayFolder: Base
		lineageTag: 0cba99e4-9a0f-4b9b-82bd-8ef394aac9ef

	/// Suma de unidades vendidas, incluyendo los contenidos de audio y video del catálogo.
	measure 'Unidades vendidas' = SUM('Ventas'[Unidades])
		formatString: #,##0
		displayFolder: Base
		lineageTag: 05d3af82-eb64-4d6b-a6db-214fc122a63a

	/// Facturas diferentes: una factura puede contener varias líneas.
	measure Facturas = DISTINCTCOUNT('Ventas'[Id factura])
		formatString: #,##0
		displayFolder: Base
		lineageTag: 1e7081c0-f0e4-4183-846e-51e59c63f2de

	/// Ingresos del mes calendario inmediatamente anterior. Sin base histórica devuelve BLANK.
	measure 'Ingresos mes anterior' =
			VAR _FechasAnteriores = PREVIOUSMONTH('Fecha'[Fecha])
			RETURN
			    IF(
			        HASONEVALUE('Fecha'[Periodo]),
			        CALCULATE([Ingresos], REMOVEFILTERS('Fecha'), _FechasAnteriores)
			    )
		formatString: #,##0.00 "UM"
		displayFolder: Comparación mensual
		lineageTag: 6ce9bfd2-b0ed-446b-9668-2b78a79d42fa

	/// Unidades del mes anterior; conserva los filtros de país, género y demás dimensiones.
	measure 'Unidades mes anterior' =
			VAR _FechasAnteriores = PREVIOUSMONTH('Fecha'[Fecha])
			RETURN
			    IF(
			        HASONEVALUE('Fecha'[Periodo]),
			        CALCULATE([Unidades vendidas], REMOVEFILTERS('Fecha'), _FechasAnteriores)
			    )
		formatString: #,##0
		displayFolder: Comparación mensual
		lineageTag: 1040edc1-a3d7-4737-b0c1-0ff8e63e5132

	/// KPI-01 | Responsable: Cristopher Quiros. Variación de ingresos frente al mes anterior. BLANK cuando no existe base o el denominador es cero.
	measure 'Crecimiento mensual de ingresos' =
			VAR _Anterior = [Ingresos mes anterior]
			RETURN IF(HASONEVALUE('Fecha'[Periodo]), DIVIDE([Ingresos] - _Anterior, _Anterior))
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: KPIs aprobados
		lineageTag: 39de7e7d-93d8-47d9-85fa-10d52cf5ab38

	/// Color condicional según el cambio histórico. No representa cumplimiento de una meta que no fue fijada.
	measure 'KPI-01 color' =
			VAR _Cambio = [Crecimiento mensual de ingresos]
			RETURN SWITCH(
			    TRUE(),
			    ISBLANK(_Cambio), "#68798B",
			    _Cambio = 0, "#68798B",
			    _Cambio > 0, "#00897B",
			    "#CB4B4B"
			)
		formatString: @
		isHidden
		displayFolder: Formato condicional
		lineageTag: d6452426-4e8f-40ec-ba1f-fdb75f7024fc

	/// KPI-05 | Responsable: Brian Rodriguez. Cambio de SUM(Unidades) frente al mes anterior; no se confunde la cantidad de una línea con el volumen mensual.
	measure 'Crecimiento mensual de unidades vendidas' =
			VAR _Anterior = [Unidades mes anterior]
			RETURN IF(HASONEVALUE('Fecha'[Periodo]), DIVIDE([Unidades vendidas] - _Anterior, _Anterior))
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: KPIs aprobados
		lineageTag: e40eab96-377e-41d6-868f-34ae262bdd64

	/// Color condicional según el cambio histórico. No representa cumplimiento de una meta que no fue fijada.
	measure 'KPI-05 color' =
			VAR _Cambio = [Crecimiento mensual de unidades vendidas]
			RETURN SWITCH(
			    TRUE(),
			    ISBLANK(_Cambio), "#68798B",
			    _Cambio = 0, "#68798B",
			    _Cambio > 0, "#00897B",
			    "#CB4B4B"
			)
		formatString: @
		isHidden
		displayFolder: Formato condicional
		lineageTag: e92db318-a42c-41e3-a3f1-8624cf345a1c

